   "id": "624f71fa-af69-455c-b744-1d199757f278",
   "name": "Удалить пост",
   "type": "n8n-nodes-base.telegram",
   "typeVersion": 1.2,
   "position": [
    1560,
    -160
   ],
   "onError": "continueErrorOutput"
