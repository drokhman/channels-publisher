   "id": "a7c34de2-16be-4121-9467-e0294d6ff69e",
   "name": "Каждые 2 минуты",
   "type": "n8n-nodes-base.scheduleTrigger",
   "typeVersion": 1.2,
   "position": [
    0,
    80
   ]
  },
  {
   "parameters": {
    "jsCode": "// === НАСТРОЙКИ ПРАВОК УЦП ===\n// Команды кладутся в GitHub: commands-ucp/имя.json\n//   { \"action\": \"edit\",   \"chat_id\": \"@канал\", \"message_id\": 12, \"text_html\": \"Новый текст\" }\n//   { \"action\": \"delete\", \"chat_id\": \"@канал\", \"message_id\": 12 }\n// Удалить ботом можно только пост младше 48 часов (ограничение Telegram). Править можно в любое время.\nreturn [{ json: {\n  repo: 'drokhman/channels-publisher',\n  folder: 'commands-ucp',                 // папка с командами\n  allowed: ['@АДРЕС_КАНАЛА'],             // где разрешено править и удалять\n  admin_chat_id: '1073319162',            // ваш личный чат: тоже разрешён, для тестов\n  committer: { name: 'n8n-edits УЦП (сервер)', email: 'publisher@channels-publisher.local' }\n} }];\n"
   },
   "id": "8ad8075e-00ff-4ec6-8331-a17b0ec528cb",
   "name": "Настройки",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    220,
    0
   ]
  },
  {
   "parameters": {
    "method": "GET",
    "url": "={{ 'https://api.github.com/repos/' + $('Настройки').first().json.repo + '/contents/' + $('Настройки').first().json.folder }}",
    "authentication": "genericCredentialType",
    "genericAuthType": "httpHeaderAuth",
    "sendHeaders": true,
    "headerParameters": {
     "parameters": [
      {
       "name": "Accept",
       "value": "application/vnd.github+json"
      },
      {
       "name": "X-GitHub-Api-Version",
       "value": "2022-11-28"
      }
     ]
    },
    "options": {}
   },
   "id": "d0b3d9a2-d5e4-4039-960b-9ecb37a5973e",
   "name": "Список команд",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    440,
    0
   ],
   "alwaysOutputData": true
  },
  {
   "parameters": {
    "jsCode": "// Берём самую раннюю команду (по имени файла)\nconst files = $input.all().map(i => i.json).filter(f => f && f.type === 'file' && String(f.name).endsWith('.json'));\nfiles.sort((a, b) => a.name.localeCompare(b.name));\nif (!files.length) return [];\nconst f = files[0];\nreturn [{ json: { name: f.name, sha: f.sha, url: f.url } }];\n"
   },
   "id": "83465e9d-6d41-4adc-815e-54e16a08f1d5",
   "name": "Выбрать команду",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    660,
    0
   ]
  },
  {
   "parameters": {
    "method": "GET",
    "url": "={{ $json.url }}",
    "authentication": "genericCredentialType",
    "genericAuthType": "httpHeaderAuth",
    "sendHeaders": true,
    "headerParameters": {
     "parameters": [
      {
       "name": "Accept",
       "value": "application/vnd.github.raw+json"
      },
      {
       "name": "X-GitHub-Api-Version",
       "value": "2022-11-28"
      }
     ]
    },
    "options": {
     "response": {
      "response": {
       "responseFormat": "json"
      }
     }
    }
   },
   "id": "d8830f4f-5b99-465f-bf95-2b57712a4579",
   "name": "Скачать команду",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    880,
    0
   ]
  },
  {
   "parameters": {
    "jsCode": "// Проверить команду\nconst cfg = $('Настройки').first().json;\nconst ALLOWED = [...cfg.allowed, String(cfg.admin_chat_id)];\nconst c = $input.first().json;\nconst file = $('Выбрать команду').first().json;\nconst base = { file: file.name, sha: file.sha, action: String(c.action || ''), chat_id: String(c.chat_id || ''),\n  message_id: Number(c.message_id), text_html: c.text_html || c.text || '', preview: !!c.preview };\nlet reason = '';\nif (!ALLOWED.includes(base.chat_id)) reason = 'Канал ' + base.chat_id + ' не в белом списке';\nelse if (!Number.isInteger(base.message_id) || base.message_id <= 0) reason = 'Нет номера сообщения message_id';\nelse if (!['edit', 'delete'].includes(base.action)) reason = 'Неизвестное действие: ' + base.action;\nelse if (base.action === 'edit' && !base.text_html) reason = 'Для правки нужен text_html';\nreturn [{ json: { ...base, go: reason ? 'reject' : base.action, reason } }];\n"
   },
   "id": "dfebf75b-043e-42ab-8829-2439a3eac5ee",
   "name": "Проверить",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1100,
    0
   ]
  },
  {
   "parameters": {
    "rules": {
     "values": [
      {
       "conditions": {
        "options": {
         "caseSensitive": true,
         "leftValue": "",
         "typeValidation": "strict"
        },
        "conditions": [
         {
          "leftValue": "={{ $json.go }}",
          "rightValue": "delete",
          "operator": {
           "type": "string",
           "operation": "equals"
          }
         }
        ],
        "combinator": "and"
       },
       "renameOutput": true,
       "outputKey": "Удалить"
      },
      {
       "conditions": {
        "options": {
         "caseSensitive": true,
         "leftValue": "",
         "typeValidation": "strict"
        },
        "conditions": [
         {
          "leftValue": "={{ $json.go }}",
          "rightValue": "edit",
          "operator": {
           "type": "string",
           "operation": "equals"
          }
         }
        ],
        "combinator": "and"
       },
       "renameOutput": true,
       "outputKey": "Исправить"
      },
      {
       "conditions": {
        "options": {
         "caseSensitive": true,
         "leftValue": "",
         "typeValidation": "strict"
        },
        "conditions": [
         {
          "leftValue": "={{ $json.go }}",
          "rightValue": "reject",
          "operator": {
           "type": "string",
           "operation": "equals"
          }
         }
        ],
        "combinator": "and"
       },
       "renameOutput": true,
       "outputKey": "Отказ"
      }
     ]
    },
    "options": {}
   },
   "id": "b67c6bc0-efb2-4916-82fc-5157ed45b5e8",
   "name": "Что сделать",
