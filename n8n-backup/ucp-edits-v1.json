  {
   "parameters": {
    "operation": "editMessageText",
    "chatId": "={{ $('Проверить').first().json.chat_id }}",
    "messageId": "={{ $('Проверить').first().json.message_id }}",
    "text": "={{ $('Проверить').first().json.text_html }}",
    "additionalFields": {
     "parse_mode": "HTML",
     "disable_web_page_preview": "={{ !$('Проверить').first().json.preview }}"
    }
   },
   "id": "59d1199c-a5f4-48b7-900f-b282c8890874",
   "name": "Исправить пост",
   "type": "n8n-nodes-base.telegram",
   "typeVersion": 1.2,
   "position": [
    1560,
    0
   ],
   "onError": "continueErrorOutput"
  },
  {
   "parameters": {
    "jsCode": "// Записать результат в commands-ucp-done/\nconst p = $('Проверить').first().json;\nconst record = { ...$('Скачать команду').first().json, result: 'ok', done_at: new Date().toISOString(), by: 'n8n-edits УЦП' };\nreturn [{ json: {\n  path: 'commands-ucp-done/' + p.file,\n  message: p.action + ' ' + p.chat_id + '/' + p.message_id + ' (n8n)',\n  content: Buffer.from(JSON.stringify(record, null, 2)).toString('base64'),\n  notify: (p.action === 'delete' ? 'Удалено: ' : 'Исправлено: ') + p.chat_id + '/' + p.message_id\n} }];\n"
   },
   "id": "c6044155-347a-4173-95e1-574e765e6cbd",
   "name": "Итог",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1800,
    -100
   ]
  },
  {
   "parameters": {
    "jsCode": "// Ошибка: команда уходит в commands-ucp-failed/ с причиной\nconst p = $('Проверить').first().json;\nconst inErr = $input.first().json.error;\nconst why = inErr ? (inErr.message || JSON.stringify(inErr)) : (p.reason || 'неизвестная ошибка');\nconst record = { ...$('Скачать команду').first().json, result: 'failed', error: String(why).slice(0, 500), at: new Date().toISOString(),\n  hint: 'Удалить ботом можно только пост младше 48 часов; старые посты удаляйте вручную в Telegram.' };\nconst stamp = new Date().toISOString().replace(/[-:]/g, '').slice(0, 13);\nreturn [{ json: {\n  path: 'commands-ucp-failed/' + p.file.replace(/\\.json$/, '') + '-' + stamp + '.json',\n  message: 'failed ' + p.file + ' (n8n)',\n  content: Buffer.from(JSON.stringify(record, null, 2)).toString('base64'),\n  notify: 'Правка УЦП не выполнена: ' + p.file + '\\nПричина: ' + String(why).slice(0, 300)\n} }];\n"
   },
