{
  "name": "Публикация из GitHub в Telegram",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 2
            }
          ]
        }
      },
      "name": "Каждые 2 минуты",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://api.github.com/repos/drokhman/channels-publisher/contents/outbox",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        },
        "options": {}
      },
      "name": "Список outbox",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.name }}",
              "rightValue": ".json",
              "operator": {
                "type": "string",
                "operation": "endsWith"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Только .json",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "maxItems": 1
      },
      "name": "Первый пост",
      "type": "n8n-nodes-base.limit",
      "typeVersion": 1,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $json.url }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github.raw+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "name": "Скачать пост",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "a1",
              "leftValue": "={{ ['@chelovek_vs_ai', '@ryadom_repetitor'].includes($json.chat_id) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Белый список каналов",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ]
    },
    {
      "parameters": {
        "method": "DELETE",
        "url": "=https://api.github.com/repos/drokhman/channels-publisher/contents/outbox/{{ $('Первый пост').item.json.name }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        },
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ message: 'publish ' + $('Первый пост').item.json.name, sha: $('Первый пост').item.json.sha }) }}"
      },
      "name": "Забрать из outbox",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const p = $('Скачать пост').first().json;\nreturn [{\n  json: { id: p.id, channel: p.channel, chat_id: p.chat_id, text_html: p.text_html },\n  binary: { photo: { data: p.image_base64, mimeType: p.image_mime || 'image/jpeg', fileName: (p.id || 'post') + '.jpg' } }\n}];"
      },
      "name": "Подготовить",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        0
      ]
    },
    {
      "parameters": {
        "operation": "sendPhoto",
        "chatId": "={{ $json.chat_id }}",
        "binaryData": true,
        "binaryPropertyName": "photo",
        "additionalFields": {}
      },
      "name": "Отправить картинку",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1760,
        0
      ]
    },
    {
      "parameters": {
        "operation": "sendMessage",
        "chatId": "={{ $('Подготовить').item.json.chat_id }}",
        "text": "={{ $('Подготовить').item.json.text_html }}",
        "additionalFields": {
          "appendAttribution": false,
          "parse_mode": "HTML",
          "disable_web_page_preview": true
        }
      },
      "name": "Отправить текст",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1980,
        0
      ]
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "=https://api.github.com/repos/drokhman/channels-publisher/contents/sent/{{ $('Подготовить').item.json.id }}.json",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        },
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ message: 'sent ' + $('Подготовить').item.json.id, content: JSON.stringify({ id: $('Подготовить').item.json.id, channel: $('Подготовить').item.json.channel, chat_id: $('Подготовить').item.json.chat_id, photo_message_id: $('Отправить картинку').item.json.result.message_id, text_message_id: $json.result.message_id, link: 'https://t.me/' + String($('Подготовить').item.json.chat_id).replace('@','') + '/' + $json.result.message_id, published_at: $now.toISO() }, null, 2).base64Encode() }) }}"
      },
      "name": "Записать в sent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2200,
        0
      ]
    }
  ],
  "connections": {
    "Каждые 2 минуты": {
      "main": [
        [
          {
            "node": "Список outbox",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Список outbox": {
      "main": [
        [
          {
            "node": "Только .json",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Только .json": {
      "main": [
        [
          {
            "node": "Первый пост",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Первый пост": {
      "main": [
        [
          {
            "node": "Скачать пост",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Скачать пост": {
      "main": [
        [
          {
            "node": "Белый список каналов",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Белый список каналов": {
      "main": [
        [
          {
            "node": "Забрать из outbox",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Забрать из outbox": {
      "main": [
        [
          {
            "node": "Подготовить",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Подготовить": {
      "main": [
        [
          {
            "node": "Отправить картинку",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Отправить картинку": {
      "main": [
        [
          {
            "node": "Отправить текст",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Отправить текст": {
      "main": [
        [
          {
            "node": "Записать в sent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Europe/Moscow"
  },
  "pinData": {}
}